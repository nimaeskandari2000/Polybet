# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID: Required for sending PolyBet signals to Telegram.
# Configure these in the AI Studio Secrets panel or GitHub Actions Repository Secrets.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DASHBOARD_URL=""

# Optional Macroeconomic & Market Data Source API Keys:
FRED_API_KEY=""
BLS_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""
EIA_API_KEY=""
BEA_API_KEY=""
